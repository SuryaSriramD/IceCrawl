PORT=3002
DATABASE_URL=postgres://icecrawl:icecrawl@localhost:5432/icecrawl
REDIS_URL=redis://localhost:6379
ICECRAWL_SNAPSHOT_DIR=./data/snapshots
ICECRAWL_USE_AUTH=true
ICECRAWL_ALLOW_PRIVATE_NETWORKS=false
ICECRAWL_STRICT=false
ICECRAWL_MAX_RESPONSE_BYTES=10485760
ICECRAWL_BROWSER=true
ICECRAWL_PREFER_BROWSER=true
ICECRAWL_BROWSER_CONCURRENCY=4
ICECRAWL_BROWSER_NO_SANDBOX=false
ICECRAWL_SIGNING_KEY_FILE=./data/signing-key.pem
ICECRAWL_QUEUE_PREFIX=icecrawl
ICECRAWL_RUN_WORKER=true
ICECRAWL_WORKER_CONCURRENCY=8
ICECRAWL_SCRAPE_MAX_ATTEMPTS=3
ICECRAWL_JOB_TTL_HOURS=24
ICECRAWL_JOB_PAGE_BYTES=10485760
ICECRAWL_MAX_CRAWL_LIMIT=100000
ICECRAWL_ALLOW_IGNORE_ROBOTS=false
ICECRAWL_PUBLIC_URL=
ICECRAWL_WEBHOOK_SECRET_FILE=./data/webhook-secret
# prompt-injection scanning: off | flag (default) | quarantine (withhold high-severity pages)
ICECRAWL_INJECTION=flag
# MCP server (packages/mcp)
ICECRAWL_API_URL=http://localhost:3002
ICECRAWL_API_KEY=
ICECRAWL_MCP_TOOL_PREFIX=icecrawl_
ICECRAWL_MCP_MAX_CHARS=30000
ICECRAWL_MCP_HOST=127.0.0.1
ICECRAWL_MCP_PORT=3003
ICECRAWL_MCP_TOKEN=
ICECRAWL_MCP_ALLOWED_HOSTS=
# search: a SearXNG instance with the json format enabled (docker compose --profile search up -d searxng)
ICECRAWL_SEARXNG_URL=
ICECRAWL_SEARCH_MAX_SCRAPE=20
# language model for /v2/extract and the json and summary formats. provider: openai (any OpenAI-compatible server) | anthropic
ICECRAWL_LLM_PROVIDER=
ICECRAWL_LLM_MODEL=
ICECRAWL_LLM_API_KEY=
ICECRAWL_LLM_BASE_URL=
ICECRAWL_LLM_TIMEOUT_MS=120000
ICECRAWL_LLM_MAX_INPUT_CHARS=100000
ICECRAWL_LLM_MAX_OUTPUT_TOKENS=4096
ICECRAWL_EXTRACT_MAX_PAGES=20
