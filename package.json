{
  "name": "icecrawl",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20.12" },
  "pnpm": { "overrides": { "light-my-request": "6.6.0" } },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres redis",
    "dev": "pnpm --filter @icecrawl/api dev"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
