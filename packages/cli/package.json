{
  "name": "@icecrawl/cli",
  "version": "0.1.0",
  "description": "Verify IceCrawl receipts: signature, snapshot hashes, converter and scanner replay.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuryaSriramD/IceCrawl.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/SuryaSriramD/IceCrawl#readme",
  "bugs": {
    "url": "https://github.com/SuryaSriramD/IceCrawl/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "exports": {
    ".": "./src/verify-cmd.ts"
  },
  "bin": {
    "icecrawl": "./bin/icecrawl.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "icecrawl": "tsx src/bin.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "~0.8.3",
    "linkedom": "^0.18.5",
    "mammoth": "~1.13.0",
    "pdfjs-dist": "4.10.38",
    "turndown": "^7.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@icecrawl/core": "workspace:*",
    "@icecrawl/scraper": "workspace:*",
    "@icecrawl/trust": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
